#!/bin/bash -l
#PBS -A datascience
#PBS -q workq
#PBS -l select=2:ncpus=64:ngpus=4,filesystems=home:tegu,walltime=00:45:00
#PBS -N conda-test-2026-10-09
#PBS -j oe
#PBS -o sirius-2026-10-09.out
# conda/2026-10-09 on Sirius: 2-node harness, per-package isolation tests, and the CUDA-lib probe
# (every [case] line should now say SOFT: the 13.4 runtime/NVRTC wheels are uninstalled).
cd $PBS_O_WORKDIR
module use /soft/modulefiles
module load conda/2026-10-09; conda activate
export MPICH_GPU_SUPPORT_ENABLED=1 DARSHAN_DISABLE=1
nvidia-smi --query-gpu=name,driver_version --format=csv | head -2
module list 2>&1 | grep -E "conda|gcc|mpich|hdf5"
echo "=== 8 ranks / 2 nodes ==="
NCCL_DEBUG=WARN mpiexec -n 8 --ppn 4 ./gpu_wrap.sh python gpu_test.py
echo "exit=$?"
echo "=== isolation tests (1 GPU)"
for t in fa fa_after_tf te ds apex vllm compile mpi4jax ort xgb mamba flashinfer gce numpyro mcore verl rl titan; do
  echo "=== $t"; CUDA_VISIBLE_DEVICES=0 python -X faulthandler isolate_2026-09-17.py $t 2>&1 | grep -vE '^(I0000|WARNING: All log|To enable the following)' | tail -25; echo "--- rc=${PIPESTATUS[0]}"
done
echo "=== CUDA lib probe (1 GPU)"
for t in torch jax cupy te flashinfer vllm; do
  echo "=== $t"; CUDA_VISIBLE_DEVICES=0 python libprobe.py $t 2>&1 | grep -E '^\[|Error|error' | tail -30; echo "--- rc=${PIPESTATUS[0]}"
done
python -c "import importlib.metadata as m; print({k: m.version(k) for k in ('cuda-bindings','cuda-python','torchtitan','datasets')})"
echo "=== all done"
