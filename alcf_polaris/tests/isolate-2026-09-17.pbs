#!/bin/bash -l
#PBS -A datascience
#PBS -q workq
#PBS -l select=1:ncpus=64:ngpus=4,filesystems=home:tegu,walltime=00:30:00
#PBS -N conda-isolate-2026-09-17
#PBS -j oe
#PBS -o isolate-2026-09-17.out
cd $PBS_O_WORKDIR
module use /soft/modulefiles
module load conda/2026-09-17; conda activate
export DARSHAN_DISABLE=1 CUDA_VISIBLE_DEVICES=0
for t in fa fa_after_tf te ds apex vllm compile mpi4jax ort xgb mamba flashinfer gce numpyro mcore verl rl titan; do
  echo "=== $t"; python -X faulthandler isolate_2026-09-17.py $t 2>&1 | grep -vE '^(I0000|WARNING: All log|To enable the following)' | tail -25; echo "--- rc=${PIPESTATUS[0]}"
done
echo "=== all done"
